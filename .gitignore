# =============================================================================
# dirLocker Project .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Go Build Artifacts
# -----------------------------------------------------------------------------
# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.syso
*.vault
dist/
vendor/

# Specific build outputs
/cli.exe
/gui.exe
/dirlocker-cli.exe
/dirlocker-gui.exe
/dirlocker-test.exe
/test-vault.exe
/dirlocker
/dirlocker-cli
/dirlocker-gui
/dirlocker-fuse
/dirlocker-dokany
/dirlocker-winfsp

# Go test binary, built with `go test -c`
*.test

# Go coverage files
*.out
*.prof
coverage.txt
coverage_data
coverage.html

# Go workspace file
go.work
go.work.sum

# -----------------------------------------------------------------------------
# Rust Build Artifacts
# -----------------------------------------------------------------------------
# Rust target directory (contains all build artifacts)
target/
**/target/

# Rust lock file (keep for applications, ignore for libraries)
# Cargo.lock is kept for reproducible builds
# Uncomment if this becomes a library:
# Cargo.lock

# Rust backup files
**/*.rs.bk

# -----------------------------------------------------------------------------
# C/C++ Build Artifacts
# -----------------------------------------------------------------------------
*.o
*.a
*.lib
*.obj

# -----------------------------------------------------------------------------
# Documentation Build Artifacts
# -----------------------------------------------------------------------------
docs/_build/
docs/.doctrees/
/site

# -----------------------------------------------------------------------------
# Logs and Temporary Files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Application logs
/log/
/logs/
dirlocker.log
vault.log
*_log*.txt
tests_*.txt
test_output*.txt

# -----------------------------------------------------------------------------
# Platform-Specific Files

# Sphinx
docs/_static/
docs/_templates/

# -----------------------------------------------------------------------------
# Platform-Specific Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*/

# -----------------------------------------------------------------------------
# Translations
# -----------------------------------------------------------------------------
*.mo
*.pot

# -----------------------------------------------------------------------------
# Jupyter Notebook
# -----------------------------------------------------------------------------
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Python Type Checkers and Linters
# -----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# -----------------------------------------------------------------------------
# Packaging and Distribution
# -----------------------------------------------------------------------------
# MSI packages (Windows)
*.msi
*.msix

# DMG packages (macOS)
*.dmg
*.pkg

# DEB packages (Linux)
*.deb

# RPM packages (Linux)
*.rpm

# AppImage (Linux)
*.AppImage

# IPA packages (iOS)
*.ipa

# APK/AAB packages (Android)
*.apk
*.aab

# -----------------------------------------------------------------------------
# Mount Points and Runtime Data
# -----------------------------------------------------------------------------
# Mount point directories
/mnt/
/mount/
*.mount/

# Runtime data
*.pid
*.sock
*.socket

# -----------------------------------------------------------------------------
# Backup and Temporary Implementation Files
# -----------------------------------------------------------------------------
*.bak
*.backup
*.old
*_backup
*_old
TASK_*_IMPLEMENTATION_SUMMARY.md

# -----------------------------------------------------------------------------
# AI and Development Tools
# -----------------------------------------------------------------------------
# Cursor AI editor
.cursorignore
.cursorindexingignore

# Kiro IDE (keep configuration)
# .kiro/ is kept for project-specific settings

# -----------------------------------------------------------------------------
# Keep Important Files
# -----------------------------------------------------------------------------
# These files should be tracked:
# - go.mod, go.sum (Go dependencies)
# - Cargo.toml, Cargo.lock (Rust dependencies)
# - .python-version (Python version specification)
# - pyproject.toml, uv.lock (Python tooling in tools/)
# - README.md, LICENSE (Documentation)
# - .gitattributes (Git configuration)
# - Build scripts: build-fuse.sh, build-fuse.bat

#Ignore vscode AI rules
.github\instructions\codacy.instructions.md


#Ignore cursor AI rules
.cursor\rules\codacy.mdc

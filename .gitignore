# =============================================================================
# dirLocker Project .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Go Build Artifacts
# -----------------------------------------------------------------------------
# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.syso
*.vault
dist/
vendor/

# Specific build outputs
/cli.exe
/gui.exe
/dirlocker-cli.exe
/dirlocker-gui.exe
/dirlocker-test.exe
/test-vault.exe
/dirlocker
/dirlocker-cli
/dirlocker-gui
/dirlocker-fuse
/dirlocker-dokany
/dirlocker-winfsp

# Go test binary, built with `go test -c`
*.test

# Go coverage files
*.out
*.prof
coverage.txt
coverage.html

# Go workspace file
go.work
go.work.sum

# -----------------------------------------------------------------------------
# Rust Build Artifacts
# -----------------------------------------------------------------------------
# Rust target directory (contains all build artifacts)
target/
**/target/

# Rust lock file (keep for applications, ignore for libraries)
# Cargo.lock is kept for reproducible builds
# Uncomment if this becomes a library:
# Cargo.lock

# Rust backup files
**/*.rs.bk

# -----------------------------------------------------------------------------
# C/C++ Build Artifacts
# -----------------------------------------------------------------------------
*.o
*.a
*.lib
*.obj

# -----------------------------------------------------------------------------
# Python Build Artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# -----------------------------------------------------------------------------
# Build and Output Directories
# -----------------------------------------------------------------------------
/bin/
/build/
/dist/
/log/
/logs/

# Keep example directories but ignore their build outputs
/examples/*/target/
/examples/*/*.exe
/examples/*/dirlocker*

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# -----------------------------------------------------------------------------
# Test Artifacts and Coverage
# -----------------------------------------------------------------------------
# Go test cache
.cache/
*.test
*.prof

# Python test artifacts
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Test vaults and temporary test files
test-vault/
test_vault/
*.vault.test
test_*.vault
*_test.vault

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------

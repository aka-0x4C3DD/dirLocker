# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Application logs
/log/*.log
/logs/*.log
dirlocker.log
vault.log
*_log*.txt
tests_*.txt


<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="dirLocker" Language="1033" Version="1.0.0.0" Manufacturer="dirLocker Team" UpgradeCode="8ad74827-cadf-40d2-ac78-11dcbcbb086f">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="ProductFeature" Title="dirLocker" Level="1">
            <ComponentGroupRef Id="ProductComponents" />
        </Feature>
    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFilesFolder">
                <Directory Id="INSTALLFOLDER" Name="dirLocker" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="dirLocker"/>
            </Directory>
        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="*">
                <File Source="bin\dirlocker-gui.exe" KeyPath="yes">
                    <Shortcut Id="ApplicationStartMenuShortcut"
                              Directory="ApplicationProgramsFolder"
                              Name="dirLocker"
                              WorkingDirectory="INSTALLFOLDER"
                              Icon="icon.ico"
                              IconIndex="0"
                              Advertise="yes" />
                </File>
            </Component>
            <Component Id="CLIExecutable" Guid="*">
                <File Source="bin\dirlocker-cli.exe" />
            </Component>
        </ComponentGroup>
    </Fragment>

    <Fragment>
        <Icon Id="icon.ico" SourceFile="pkg\iconmanager\default_icon.ico"/>
    </Fragment>
</Wix>
